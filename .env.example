# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=production
HTTP_ADDR=:8080

# PostgreSQL and Redis must be configured together.
DATABASE_URL=postgres://tgqf_user:CHANGE_ME@postgres:5432/tgqf?sslmode=disable
REDIS_URL=redis://redis:6379/0

# One-time bootstrap. Remove these after the first successful super-admin creation.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Required before importing Telegram sessions. Exactly 32 random bytes, Base64 encoded.
# Generate: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Authentication request throttles (per source IP).
AUTH_REGISTER_LIMIT=5
AUTH_REGISTER_WINDOW=10m
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW=5m


# Telegram MTProto credentials from my.telegram.org (keep private).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Device identity defaults; model and iOS version are generated by device-manager.
DEFAULT_LANG_CODE=en
DEFAULT_SYSTEM_LANG_CODE=en-US
DEFAULT_LANG_PACK=ios
# Optional override; otherwise device-manager's profile version is retained.
TELEGRAM_APP_VERSION=
