# Copy this file to .env and fill in real values. Never commit .env.
APP_ENV=production
TGQF_IMAGE_TAG=release-2026-11-04
HTTP_ADDR=:8080
# Public origin is served by host Nginx; keep API/frontend container ports private.
NEXT_PUBLIC_API_BASE_URL=

# PostgreSQL and Redis must be configured together.
POSTGRES_USER=tgqf_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD_USE_HEX
POSTGRES_DB=tgqf
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_USE_HEX
DATABASE_URL=postgres://tgqf_user:CHANGE_ME_DB_PASSWORD_USE_HEX@postgres:5432/tgqf?sslmode=disable
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD_USE_HEX@redis:6379/0

# One-time bootstrap. Remove these after the first successful super-admin creation.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Required before importing Telegram sessions. Exactly 32 random bytes, Base64 encoded.
# Generate: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Authentication request throttles (per source IP).
AUTH_REGISTER_LIMIT=5
AUTH_REGISTER_WINDOW=10m
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW=5m


# Telegram MTProto credentials from my.telegram.org (keep private).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Device identity defaults; model and iOS version are generated by device-manager.
DEFAULT_LANG_CODE=en
DEFAULT_SYSTEM_LANG_CODE=en-US
DEFAULT_LANG_PACK=ios
# Optional override; otherwise device-manager's profile version is retained.
TELEGRAM_APP_VERSION=

# Optional deployment safety thresholds (KB). Installer defaults to 1 GiB;
# backup preflight is disabled by default unless MIN_BACKUP_FREE_KB is set.
MIN_DEPLOY_FREE_KB=1048576
MIN_BACKUP_FREE_KB=0
